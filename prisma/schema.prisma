generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  users     User[]
  documents Document[]
  vendors   Vendor[]
}

enum Role {
  MANAGER
  MEMBER
}

model User {
  id          String @id @default(cuid())
  tenantId    String
  clerkUserId String @unique
  email       String
  role        Role   @default(MEMBER)
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Vendor {
  id        String     @id @default(cuid())
  tenantId  String
  name      String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([tenantId])
}

enum DocumentType {
  VENDOR_CERTIFICATE
  AUDIT_REPORT
  COMPLIANCE_CHECKLIST
}

model Document {
  id       String            @id @default(cuid())
  tenantId String
  vendorId String?
  title    String
  type     DocumentType
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor   Vendor?           @relation(fields: [vendorId], references: [id])
  versions DocumentVersion[]

  @@index([tenantId, type])
}

model DocumentVersion {
  id            String    @id @default(cuid())
  documentId    String
  versionNumber Int
  fileUrl       String // Backblaze B2 URL
  isCurrent     Boolean   @default(true)
  expiryDate    DateTime? // for vendor certificates
  uploadedAt    DateTime  @default(now())
  document      Document  @relation(fields: [documentId], references: [id])
  chunks        Chunk[]

  @@index([documentId, isCurrent])
}

model Chunk {
  id                String          @id @default(cuid())
  tenantId          String // denormalized on purpose — see "why" below
  documentVersionId String
  sectionPath       String
  sectionLevel      Int
  chunkIndex        Int
  pageStart         Int?
  pageEnd           Int?
  text              String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id])

  @@index([tenantId])
}
