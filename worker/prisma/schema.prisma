generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  users     User[]
  documents Document[]
  vendors   Vendor[]
}

enum Role {
  MANAGER
  MEMBER
}

model User {
  id          String @id @default(cuid())
  tenantId    String
  clerkUserId String @unique
  email       String
  role        Role   @default(MEMBER)
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chats       Chat[]

  @@index([tenantId])
}

model Vendor {
  id        String     @id @default(cuid())
  tenantId  String
  name      String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([tenantId])
}

enum DocumentType {
  VENDOR_CERTIFICATE
  AUDIT_REPORT
  COMPLIANCE_CHECKLIST
}

model Document {
  id       String            @id @default(cuid())
  tenantId String
  vendorId String?
  title    String
  type     DocumentType
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor   Vendor?           @relation(fields: [vendorId], references: [id])
  versions DocumentVersion[]

  @@index([tenantId, type])
}

model DocumentVersion {
  id            String    @id @default(cuid())
  documentId    String
  versionNumber Int
  fileUrl       String // Backblaze B2 URL
  isCurrent     Boolean   @default(true)
  expiryDate    DateTime? // for vendor certificates
  uploadedAt    DateTime  @default(now())
  document      Document  @relation(fields: [documentId], references: [id])
  chunks        Chunk[]

  @@index([documentId, isCurrent])
}

model Chunk {
  id                String                      @id @default(cuid())
  tenantId          String
  documentVersionId String
  sectionPath       String
  sectionLevel      Int
  chunkIndex        Int
  pageStart         Int?
  pageEnd           Int?
  text              String
  embedding         Unsupported("vector(768)")?
  documentVersion   DocumentVersion             @relation(fields: [documentVersionId], references: [id])

  @@index([tenantId])
}

model Chat {
  id        String   @id @default(cuid())
  title     String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userId, title])
  @@index([userId])
}

enum MessageRole {
  user
  ai
}

model Message {
  id        String      @id @default(cuid())
  chatId    String
  role      MessageRole
  content   String
  timestamp DateTime    @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
}
